{
  "$description": "Reachwise design tokens. The single source for the website, a mobile web view and a future mobile app (React Native can import this file directly). tokens.css mirrors these values as CSS variables.",
  "color": {
    "primary":        "#2F3BA2",
    "primaryHover":   "#252F87",
    "primaryWash":    "#ECEEFB",
    "primaryInk":     "#1F2878",
    "accent":         "#E8A33D",
    "accentWash":     "#FDF3E3",
    "ink":            "#12152B",
    "inkSoft":        "#3D4260",
    "muted":          "#6A6F88",
    "background":     "#F6F7FB",
    "surface":        "#FFFFFF",
    "line":           "#E3E5EF",
    "lineStrong":     "#C9CDDD",
    "success":        "#157A55",
    "successWash":    "#E3F4EC",
    "warning":        "#9A5B00",
    "warningWash":    "#FDF1DE",
    "danger":         "#C0353F",
    "dangerWash":     "#FBE9EA",
    "onPrimary":      "#FFFFFF"
  },
  "font": {
    "sans":  "Manrope",
    "serif": "Source Serif 4",
    "sizes": { "xs": 12, "sm": 14, "md": 16, "lg": 20, "xl": 28, "display": 44 },
    "weights": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700, "extrabold": 800 }
  },
  "radius": { "sm": 8, "md": 12, "lg": 18, "pill": 999 },
  "space":  { "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40 },
  "shadow": {
    "card":  "0 1px 2px rgba(18,21,43,0.04), 0 2px 8px rgba(18,21,43,0.04)",
    "float": "0 12px 36px rgba(18,21,43,0.16)"
  },
  "layout": { "sidebar": 256, "content": 900, "bottomNav": 64, "touchTarget": 44 }
}
