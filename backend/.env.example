# Copy to .env and fill in.  Never commit .env or share it.

APP_NAME=Reachwise
# The public HTTPS address of this server (your ngrok static domain), no trailing slash.
PUBLIC_URL=https://your-name.ngrok-free.app

# Where the website is hosted, if not on this server (comma separated).
# Google sign-in is allowed to return the student there.
ALLOWED_RETURN_ORIGINS=https://profmail.netlify.app

# ---- MongoDB Atlas ---------------------------------------------------------
# Atlas → Database → Connect → Drivers → copy the string, put your DB user's password in
MONGODB_URI=mongodb+srv://profmail:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=profmail

# ---- Secrets: run  python -m app.keys  and paste both lines here -----------
JWT_SECRET=
# Encrypts students' app passwords. If you lose or change it, every student must reconnect Gmail.
ENCRYPTION_KEY=

# ---- Google sign-in (Google Cloud Console → APIs & Services → Credentials) --
# Web application client. Authorized redirect URI: https://profmail.netlify.app/  (the website, with the slash)
GOOGLE_WEB_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_WEB_CLIENT_SECRET=

# ---- Claude (optional) -----------------------------------------------------
# Students write their emails with any free AI, so no key is needed for that.
# A key only makes reply sorting smarter; leave empty to use keyword rules (free).
ANTHROPIC_API_KEY=
CLAUDE_FAST_MODEL=claude-haiku-5-5

# ---- Sending ---------------------------------------------------------------
MIN_GAP_SECONDS=70
MAX_GAP_SECONDS=120
DAILY_CAP=80
REMINDER_AFTER_DAYS=5
MAX_REMINDERS=2

# ---- Notifications ---------------------------------------------------------
NUDGE_CHECK_MINUTES=60
# Optional: path to a Firebase service-account JSON for phone push notifications
FIREBASE_CREDENTIALS=

# Testing only. Lets anyone sign in as any email. Keep false on the internet.
DEV_LOGIN=false
